set -o vi
setopt AUTO_CD

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="dracula"

HIST_STAMPS="yyyy-mm-dd"

plugins=(git autojump zsh-syntax-highlighting zsh-autosuggestions brew node npm fzf) 

source $ZSH/oh-my-zsh.sh

export PATH=/usr/local/bin:$PATH

# Go 环境配置
export GOPATH=$HOME/go
export PATH=$PATH:$GOPATH/bin

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

. "$HOME/.local/bin/env"
___MY_VMOPTIONS_SHELL_FILE="${HOME}/.jetbrains.vmoptions.sh"; if [ -f "${___MY_VMOPTIONS_SHELL_FILE}" ]; then . "${___MY_VMOPTIONS_SHELL_FILE}"; fi

# Initialize Starship prompt
eval "$(starship init zsh)"

source /Users/lishaoying/.config/broot/launcher/bash/br

# alias
alias la=tree
alias cat=bat

# Dirs
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."

# Git
alias gc="git commit -m"
alias gca="git commit -a -m"
alias gp="git push origin HEAD"
alias gpu="git pull origin"
alias gst="git status"
alias glog="git log --graph --topo-order --pretty='%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N' --abbrev-commit"
alias gdiff="git diff"
alias gco="git checkout"
alias gb='git branch'
alias gba='git branch -a'
alias gadd='git add'
alias ga='git add -p'
alias gcoall='git checkout -- .'
alias gr='git remote'
alias gre='git reset'

# Chezmoi
alias chi="chezmoi"

# Eza
alias l="eza -l --icons --git -a"
alias ls="eza --icons=always"
alias lt="eza --tree --level=2 --long --icons --git"
alias ltree="eza --tree --level=2  --icons --git"

eval "$(zoxide init zsh)"
alias cd="z"

# timg (list image)
alias ils='timg --grid=4x1 --upscale=i --center --title --frames=1 '

# nvim bob
export PATH="$HOME/.local/share/bob/nvim-bin:$PATH"

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#ffffff,bg=#45475a"

# 1. 最高频：用 v 一键启动 nvim（最短按键）
alias v='nvim'

# 2. 无缝替换：输入 vim 实际启动 nvim（覆盖系统原生 vim）
alias vim='nvim'

# 3. 贴合 LazyVim 场景：快速打开配置
alias lvimconf='cd ~/.config/nvim && nvim ./init.lua'       # 主配置
alias lvimplug='cd ~/.config/nvim && nvim ./lua/plugins/'    # 插件配置目录

# 启动 nvim 直接打开 Lazy 插件管理面板
alias lz='nvim +Lazy'

# 以只读模式打开文件（防止误修改配置/代码）
alias nvimro='nvim -R'

# 快速编辑 zsh 配置，保存后自动生效
alias zshrc='nvim ~/.zshrc && source ~/.zshrc'

# FZF
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
# 补全时预览文件内容（需要先 brew install bat 实现高亮预览）
export FZF_DEFAULT_OPTS="--height 50% --layout reverse --border rounded --preview-window right:60%"

# 文件补全的预览命令
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers {}'"

# 终端启动显示 fastfetch + 彩色唐诗奶牛
alias ff='fastfetch --logo-type command-raw --logo "fortune song100 | cowsay -W 50 | lolcat -f"'

# if [[ -o interactive ]]; then
#   fastfetch --logo-type command-raw --logo "fortune tang300 | cowsay -W 50 | lolcat -f"
# fi

export EDITOR=nvim
