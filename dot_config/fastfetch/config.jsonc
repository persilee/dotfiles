{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  // Logo 设置
  "logo": {
    "type": "auto"
  },

  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
    },
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "34" // = color4
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "terminalfont",
      "key": " ",
      "keyColor": "34"
    },
    {
      // 各包管理器安装数量（brew formula / cask / npm 等）
      "type": "packages",
      "key": "󰏖 ",
      "keyColor": "34"
    },
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7}",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "gpu",
      "format": "{2} @ {12}",
      "key": "󰢮 ",
      "keyColor": "34"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "keyColor": "34"
    },
    {
      "type": "monitor",
      // format 占位符：{2}x{3}=分辨率(px) {6}=对角线英寸 {7}=PPI {11}=刷新率Hz
      "format": "{2}x{3} px @ {11} Hz - ({6} inches · {7} PPI)",
      "key": " ",
      "keyColor": "34"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
    },
    "break",
    "break"
  ]
}
