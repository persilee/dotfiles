# =========================================================
# ~/.zshenv —— zsh 启动最先读取的入口文件（固定路径）
# 作用：设置 ZDOTDIR，让 zsh 从 ~/.config/zsh/ 加载整套配置
# 说明：本文件只做这一件事；其余环境变量在 $ZDOTDIR/.zshenv 中定义
# =========================================================

# 将 zsh 配置目录指向 ~/.config/zsh/
export ZDOTDIR="$HOME/.config/zsh"
